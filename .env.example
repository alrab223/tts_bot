# 必須。新しいBotのトークンを設定する
BOT_TOKEN=
# 通常は空欄で全サーバーにコマンドを登録。開発用サーバーへの即時登録時だけ指定する
COMMAND_GUILD_ID=
# 通常変更不要。保存先はDockerのnamed volumeになる
DATA_DIR=./data
FFMPEG_EXECUTABLE=ffmpeg
QUEUE_LIMIT=32
# Google Sheets辞書を使う場合だけ設定する。未設定ならdata/dictionary.csvを使う
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
